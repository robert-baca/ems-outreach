# Copy this to .env and fill in values for your hospital deployment

# Clerk auth (optional — omit to run without login)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Hospital branding (overridden at runtime by /api/hospital when Clerk is enabled)
VITE_HOSPITAL_NAME=Baylor Scott & White Medical Center — [Location]
VITE_HOSPITAL_TAGLINE=A Baylor [Location] EMS Solution

# Map center coordinates and initial zoom level
VITE_MAP_LAT=32.9339
VITE_MAP_LON=-97.0783
VITE_MAP_ZOOM=10
